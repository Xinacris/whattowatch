{
  "expo": {
    "name": "WhatToWatch",
    "slug": "whattowatch",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whattowatch",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "app.whattowatch.mobile",
      "associatedDomains": [
        "applinks:whattowatchxinny.vercel.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-foreground.png",
        "monochromeImage": "./assets/images/android-monochrome.png",
        "backgroundColor": "#16110D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.whattowatch.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "whattowatchxinny.vercel.app",
              "pathPrefix": "/match"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16110D"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#16110D"
  }
}
